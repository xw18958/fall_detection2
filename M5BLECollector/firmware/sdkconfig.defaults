# M5StickC PLUS2: ESP32-PICO-V3-02, 8 MB flash, 2 MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Validate Internet OTA HTTPS servers against the ESP-IDF root certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Custom A/B application layout: ota_0 + ota_1 + otadata.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# A newly OTA-flashed application must pass the startup checks and explicitly
# mark itself valid. If it crashes or fails startup, the bootloader can return
# to the previous known-good OTA slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Device latency target: supported 240 MHz clock and performance compilation.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# BLE collector: one connection, NimBLE only. Wi-Fi starts only in detector mode.
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=185
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
# ESP-IDF 5.5.3 host flow control can stall BLE and lose the connection.
# Espressif's documented workaround: https://github.com/espressif/esp-idf/issues/18323
CONFIG_BT_NIMBLE_HS_FLOW_CTRL=n
