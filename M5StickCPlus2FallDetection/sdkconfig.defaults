# M5StickC PLUS2: ESP32-PICO-V3-02, 8 MB flash, 2 MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Validate Internet OTA HTTPS servers against the ESP-IDF root certificate bundle.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# GitHub release artifacts are pre-encrypted with Espressif's RSA-3072 + AES-GCM
# encrypted-image format. The private RSA key remains a local, gitignored build input.
CONFIG_PRE_ENCRYPTED_OTA_USE_RSA=y
# CONFIG_PRE_ENCRYPTED_RSA_USE_DS is not set

# Custom A/B application layout: ota_0 + ota_1 + otadata.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# A newly OTA-flashed application must pass the startup checks and explicitly
# mark itself valid. If it crashes or fails startup, the bootloader can return
# to the previous known-good OTA slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
