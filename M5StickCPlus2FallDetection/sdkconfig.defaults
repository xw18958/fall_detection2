# M5StickC PLUS2: ESP32-PICO-V3-02, 8 MB flash, 2 MB PSRAM
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Custom A/B application layout: ota_0 + ota_1 + otadata.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# A newly OTA-flashed application must pass the startup checks and explicitly
# mark itself valid. If it crashes or fails startup, the bootloader can return
# to the previous known-good OTA slot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
